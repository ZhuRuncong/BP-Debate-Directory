FROM python:3.12-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ git && rm -rf /var/lib/apt/lists/*
ARG DEBATERSKILL_REF=main
RUN pip wheel --no-deps -w /wheels "debaterskill @ git+https://github.com/ZhuRuncong/debaterskill@${DEBATERSKILL_REF}"

FROM python:3.12-slim
WORKDIR /app
COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl
COPY pyproject.toml ./
COPY pipeline ./pipeline
COPY scripts ./scripts
RUN pip install --no-cache-dir --no-deps -e . && pip install --no-cache-dir "psycopg[binary]>=3.1" "httpx>=0.27" "brotli>=1.1" "numpy>=1.26" "transformers>=4.40" && pip install --no-cache-dir "torch>=2.2" --index-url https://download.pytorch.org/whl/cpu
EXPOSE 8090
CMD ["python", "-m", "debate_ratings.api"]
